# 복사해서 .env로 쓴다(.env는 커밋하지 않는다). 값이 비어 있으면 설정하지 않은 것으로 본다.

# Claude API 키(필수). https://console.anthropic.com
ANTHROPIC_API_KEY=

# 작업 폴더(호스트). 비우면 이 폴더 옆의 ./work 라는 "새 빈 작업 폴더"를 만들어 쓴다.
# 이미 쓰던 작업 폴더를 쓰려면 그 경로를 적는다(Windows도 슬래시로):
#   YTC_WORK_DIR=C:/ai/projects/orca/nahon-workspace
# 주의: 읽기/쓰기로 마운트된다. 컨테이너가 그 폴더에 workspace/ 와 ui.lock 을 쓴다.
#   같은 폴더로 내 PC의 `ytc ui`가 떠 있으면 먼저 끈다(`ytc ui --stop`). 동시에 열지 않는다.
# Linux: 폴더 소유자와 맞도록 아래 YTC_UID/YTC_GID 를 `id -u`, `id -g` 값으로 설정한다.
YTC_WORK_DIR=

# 자막 수집이 막힐 때 프록시(예: http://user:pass@host:port)
YT_PROXY=

# 모델·최대 토큰(비우면 코드 기본값)
YTC_LLM_MODEL=
YTC_LLM_MAX_TOKENS=

# 선택: 화면 포트(기본 8765), 컨테이너 실행 uid/gid(Linux에서 `id -u`, `id -g`)
# YTC_PORT=8765
# YTC_UID=1000
# YTC_GID=1000
