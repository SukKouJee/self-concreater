# 서버판 설정. 복사해서 같은 폴더의 .env로 쓴다(.env는 커밋하지 않는다). docker compose가 이 파일을 읽는다.
#   cp .env.example .env
# 비밀번호·비밀키 만드는 법(URL 안전 문자만 나온다. $ 문자는 넣지 않는다):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 시작 순서: docker compose up -d --build  ->  첫 사용자 초대:
#   docker compose --profile admin run --rm admin add-user you@gmail.com --admin
# 값이 비어 있으면 기본값을 쓴다(필수 표시가 있는 것만 반드시 채운다).

# ---- 로그인·공개 주소 -------------------------------------------------------------

# 실행 환경: production(기본) | dev | test. production은 https 공개 주소와 Google 로그인이 있어야 시작한다.
# dev·test는 개발·시험용(YTC_DEV_LOGIN=1 이메일 로그인 허용). 실제 서비스에서는 production만 쓴다.
YTC_ENV=production

# [필수] 사용자가 브라우저로 여는 주소. production은 https://도메인 (경로 없이). CSRF 검사의 기준 출처다.
YTC_PUBLIC_URL=

# [필수] 세션 쿠키 서명 비밀키(32바이트 이상). 바꾸면 모두 로그아웃된다.
YTC_SESSION_SECRET=

# Google 로그인(production 필수). Google Cloud Console > OAuth 클라이언트(웹 애플리케이션)에서 만들고
# 승인된 리디렉션 URI에 <YTC_PUBLIC_URL>/auth/google/callback 을 넣는다. 둘 다 채우거나 둘 다 비운다.
YTC_GOOGLE_CLIENT_ID=
YTC_GOOGLE_CLIENT_SECRET=

# 개발·시험용 이메일 로그인(1). production에서는 시작이 거부된다. 운영에서는 비워 둔다.
YTC_DEV_LOGIN=

# 자동 HTTPS(caddy, docker compose --profile tls up -d)를 쓸 때의 도메인. YTC_PUBLIC_URL과 같은 호스트.
YTC_DOMAIN=

# 호스트에 게시할 포트(127.0.0.1 전용, 기본 8080). caddy를 쓰면 caddy가 이 앱으로 연결한다.
# YTC_PORT=8080

# ---- 데이터베이스(PostgreSQL 16) ---------------------------------------------------

# [필수] owner 롤(ytc_owner) 비밀번호: 마이그레이션·관리 명령 전용. 앱은 쓰지 않는다.
YTC_DB_OWNER_PASSWORD=
# [필수] 앱 롤(ytc_app) 비밀번호: 마이그레이션이 이 비밀번호로 롤을 만들거나 갱신한다. owner와 다르게.
YTC_DB_APP_PASSWORD=
# 앱의 DB 연결 풀 크기(기본 1~10)
# YTC_DB_POOL_MIN=1
# YTC_DB_POOL_MAX=10

# ---- 파일 저장소(MinIO) ------------------------------------------------------------

# [필수] MinIO 관리자 계정이자 앱이 쓰는 S3 키. 접근 키는 3자 이상, 비밀 키는 8자 이상.
# 둘 다 영문·숫자·-_ 만 쓴다(주소 조립에 들어가므로 @ : / ? # % $ 같은 문자는 금지). 비밀 키는 token_urlsafe로 만든다.
YTC_S3_ACCESS_KEY=
YTC_S3_SECRET_KEY=
# 버킷 이름(기본 ytc)
# YTC_S3_BUCKET=ytc
# boto 연결 풀 크기(기본 10)
# YTC_S3_MAX_POOL_CONNECTIONS=10

# ---- Claude(분석·기획 등 AI 호출) --------------------------------------------------

# Claude API 키. 비어 있으면 AI 호출이 모두 실패한다(화면 점검은 가능). https://console.anthropic.com
ANTHROPIC_API_KEY=
# 모델(비우면 코드 기본값). 가격표에 있는 모델만 쓸 수 있다.
YTC_LLM_MODEL=
# 호출 1번의 최대 출력 토큰(기본 16000)
YTC_LLM_MAX_TOKENS=
# 사용자당 하루 사용 한도(USD, 한국 시간 기준 하루, 기본 1.00). 사용자별 값은 add-user --daily-limit
YTC_DAILY_USD=

# ---- 동시 작업 한도(서버 전체) ------------------------------------------------------

# 영상 처리(다운로드·장면 분석·받아쓰기) 동시 개수(기본 2). 서버 CPU·메모리에 맞춘다.
YTC_MEDIA_SLOTS=
# Claude 호출 동시 개수(기본 4)
YTC_LLM_SLOTS=
# 앱 컨테이너 메모리 상한(기본 3g). 영상 처리 슬롯을 늘리면 같이 올린다.
# YTC_APP_MEM_LIMIT=3g
# 앱 컨테이너의 임시 폴더(tmpfs, 기본 1g). tmpfs에 쓴 만큼이 위 메모리 상한에 포함된다:
# 임시 폴더를 키우면 메모리 상한도 같이 올린다(임시 폴더 + 작업 메모리 < 상한).
# YTC_SCRATCH_SIZE=1g

# ---- 유튜브 수집 --------------------------------------------------------------------

# 자막 수집이 막힐 때 프록시(예: http://user:pass@host:port)
YT_PROXY=
# 유튜브 요청 사이 최소 간격(초, 기본 3). 서버 전체가 나눠 쓴다.
YT_FETCH_INTERVAL=

# ---- 선택: 이미지 이름 --------------------------------------------------------------
# YTC_IMAGE=ytc:server
